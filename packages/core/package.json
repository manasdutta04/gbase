{
  "name": "gbase",
  "version": "1.0.0",
  "description": "Zero-cost, version-controlled database powered by Git",
  "license": "MIT",
  "author": "Manas Dutta",
  "repository": {
    "type": "git",
    "url": "https://github.com/manasdutta04/gbase.git"
  },
  "homepage": "https://github.com/manasdutta04/gbase#readme",
  "keywords": [
    "database",
    "git",
    "github",
    "gitlab",
    "bitbucket",
    "json",
    "serverless",
    "zero-cost"
  ],
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean"
  },
  "dependencies": {
    "zod": "^3.22.4",
    "nanoid": "^5.0.6"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsup": "^8.0.0"
  }
}
