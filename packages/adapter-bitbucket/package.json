{
  "name": "@gbase/bitbucket",
  "version": "1.0.0",
  "description": "Bitbucket adapter for gbase",
  "license": "MIT",
  "author": "Manas Dutta",
  "repository": {
    "type": "git",
    "url": "https://github.com/manasdutta04/gbase.git"
  },
  "homepage": "https://github.com/manasdutta04/gbase#readme",
  "keywords": [
    "gbase",
    "bitbucket",
    "adapter",
    "database"
  ],
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean"
  },
  "peerDependencies": {
    "gbase": ">=1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsup": "^8.0.0",
    "gbase": "workspace:*"
  }
}
